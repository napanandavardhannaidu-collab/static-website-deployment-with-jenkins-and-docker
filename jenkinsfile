    agent any

    stages {
        stage('Clone') {
            steps {
                git branch: 'main',
                url: 'https://github.com/napanandavardhannaidu-collab/static-website-deployment-with-jenkins-and-docker.git'
            }
        }

        stage('Build') {
            steps {
                echo "Build successful"
            }
        }
    }
}
